    {
      "id": "dashboard",
      "title": "Aujourd'hui",
      "status": "aggregator",
      "notes": "Agrège modules syncés ; pas d'entité CK dédiée"
    },
    {
      "id": "activities",
      "title": "Activités",
      "status": "synced",
      "recordTypes": ["SharedActivity"]
    },
    {
      "id": "tasks",
      "title": "Tâches",
      "status": "synced",
      "recordTypes": ["SharedFamilyTask"]
    },
    {
      "id": "familyLife",
      "title": "Vie pratique",
      "status": "partial",
      "recordTypes": ["SharedHealthRecord", "SharedUsefulContact", "SharedFamilyBenefit", "SharedHouseholdSubscription"],
      "localOnlyModels": ["FamilyReward", "RewardPointAdjustment", "HealthReimbursement", "FamilyHealthAttachment"]
    },
    {
      "id": "shopping",
      "title": "Courses",
      "status": "synced",
