        "SharedChatConversation",
        "SharedChatParticipant",
        "SharedChatMessage",
        "SharedChatReaction",
        "SharedChatReadReceipt"
      ],
      "notes": "Chemin dédié FamilyCloudSync.syncChat + syncAllSharedData"
    },
    {
